# Runtime
ENV=local
LOG_LEVEL=info
HTTP_ADDRESS=:8081

# Database
# Local infrastructure maps auth Postgres to host port 15432.
# In Docker, use postgres-auth:5432 instead of localhost:15432.
DB_DSN=postgres://postgres:postgres@localhost:15432/auth_db?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT RSA keys
# Local monorepo path: ../keys/*.pem
# Container path example: /app/keys/*.pem
JWT_PRIVATE_KEY_PATH=../keys/private.pem
JWT_PUBLIC_KEY_PATH=../keys/public.pem

# Token TTL
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
VERIFY_TOKEN_TTL=24h

# Kafka
# Local host listener: localhost:29092
# Docker network listener: kafka:9092
KAFKA_BROKERS=localhost:29092

# Security
BCRYPT_COST=12
REQUIRE_EMAIL_VERIFIED=true
FRONTEND_URL=http://localhost:5173
HEADER_HMAC_KEY=diploma-internal-hmac-secret-key-2026
